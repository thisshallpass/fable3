{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Verify open sketch",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\.vscode\\verify.ps1", "${file}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Verify all 20 sketches",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\.vscode\\verify.ps1"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
